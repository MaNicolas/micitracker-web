---
import Layout from '../layouts/Layout.astro';
import { t } from '../i18n/index';
---

<Layout title="Confidentialité">
  <style>
    .card {
      background: #fff;
      border-radius: 16px;
      padding: 32px;
      margin-bottom: 20px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.05);
    }
    h1 {
      font-size: 32px;
      font-weight: 700;
      color: #2D6A4F;
      margin-bottom: 6px;
    }
    .date {
      font-size: 13px;
      color: #9CA3AF;
      margin-bottom: 32px;
    }
    h2 {
      font-size: 19px;
      font-weight: 700;
      color: #2D6A4F;
      margin-bottom: 14px;
      padding-bottom: 8px;
      border-bottom: 2px solid #D8F3DC;
    }
    p { font-size: 16px; line-height: 1.7; color: #1A1A2E; margin-bottom: 10px; }
    ul { padding-left: 20px; margin-bottom: 10px; }
    li { font-size: 16px; line-height: 1.7; color: #1A1A2E; margin-bottom: 4px; }
    a { color: #2D6A4F; }
    .highlight {
      background: #D8F3DC;
      border-left: 4px solid #2D6A4F;
      padding: 12px 16px;
      border-radius: 0 8px 8px 0;
      margin-bottom: 12px;
      font-size: 14px;
      line-height: 1.6;
    }
  </style>

  <h1 data-i18n="privacy.title">{t('fr', 'privacy.title')}</h1>
  <p class="date" data-i18n="privacy.date">{t('fr', 'privacy.date')}</p>

  <!-- Section 1 -->
  <div class="card">
    <h2 data-i18n="privacy.s1.title">{t('fr', 'privacy.s1.title')}</h2>
    <p data-i18n="privacy.s1.p1" set:html={t('fr', 'privacy.s1.p1')} />
    <p data-i18n="privacy.s1.p2" set:html={t('fr', 'privacy.s1.p2')} />
  </div>

  <!-- Section 2 -->
  <div class="card">
    <h2 data-i18n="privacy.s2.title">{t('fr', 'privacy.s2.title')}</h2>
    <div class="highlight" data-i18n="privacy.s2.highlight">{t('fr', 'privacy.s2.highlight')}</div>
    <p data-i18n="privacy.s2.intro">{t('fr', 'privacy.s2.intro')}</p>
    <ul>
      <li data-i18n="privacy.s2.account" set:html={t('fr', 'privacy.s2.account')} />
      <li data-i18n="privacy.s2.stool" set:html={t('fr', 'privacy.s2.stool')} />
      <li data-i18n="privacy.s2.food" set:html={t('fr', 'privacy.s2.food')} />
      <li data-i18n="privacy.s2.meds" set:html={t('fr', 'privacy.s2.meds')} />
      <li data-i18n="privacy.s2.profile" set:html={t('fr', 'privacy.s2.profile')} />
      <li data-i18n="privacy.s2.notifs" set:html={t('fr', 'privacy.s2.notifs')} />
    </ul>
  </div>

  <!-- Section 3 -->
  <div class="card">
    <h2 data-i18n="privacy.s3.title">{t('fr', 'privacy.s3.title')}</h2>
    <p data-i18n="privacy.s3.intro">{t('fr', 'privacy.s3.intro')}</p>
    <ul>
      <li data-i18n="privacy.s3.li1">{t('fr', 'privacy.s3.li1')}</li>
      <li data-i18n="privacy.s3.li2">{t('fr', 'privacy.s3.li2')}</li>
      <li data-i18n="privacy.s3.li3">{t('fr', 'privacy.s3.li3')}</li>
      <li data-i18n="privacy.s3.li4">{t('fr', 'privacy.s3.li4')}</li>
    </ul>
    <p data-i18n="privacy.s3.legal">{t('fr', 'privacy.s3.legal')}</p>
  </div>

  <!-- Section 4 -->
  <div class="card">
    <h2 data-i18n="privacy.s4.title">{t('fr', 'privacy.s4.title')}</h2>
    <p data-i18n="privacy.s4.p1" set:html={t('fr', 'privacy.s4.p1')} />
    <p data-i18n="privacy.s4.p2">{t('fr', 'privacy.s4.p2')}</p>
    <p data-i18n="privacy.s4.p3">{t('fr', 'privacy.s4.p3')}</p>
  </div>

  <!-- Section 5 -->
  <div class="card">
    <h2 data-i18n="privacy.s5.title">{t('fr', 'privacy.s5.title')}</h2>
    <p data-i18n="privacy.s5.p1">{t('fr', 'privacy.s5.p1')}</p>
  </div>

  <!-- Section 6 - Delete account -->
  <div class="card" id="delete-account">
    <h2 data-i18n="privacy.s6.title">{t('fr', 'privacy.s6.title')}</h2>
    <p data-i18n="privacy.s6.intro">{t('fr', 'privacy.s6.intro')}</p>
    <ul>
      <li data-i18n="privacy.s6.delete" set:html={t('fr', 'privacy.s6.delete')} />
      <li data-i18n="privacy.s6.reset" set:html={t('fr', 'privacy.s6.reset')} />
    </ul>
    <p data-i18n="privacy.s6.immediate">{t('fr', 'privacy.s6.immediate')}</p>
    <div style="text-align:center; margin-top:16px;">
      <img src="/screenshots/delete-account.jpeg" alt={t('fr', 'privacy.s6.imgAlt')} data-i18n-alt="privacy.s6.imgAlt" style="max-width:360px; border-radius:12px; box-shadow:0 2px 8px rgba(0,0,0,0.1);" />
    </div>
  </div>

  <!-- Section 7 -->
  <div class="card">
    <h2 data-i18n="privacy.s7.title">{t('fr', 'privacy.s7.title')}</h2>
    <p data-i18n="privacy.s7.intro">{t('fr', 'privacy.s7.intro')}</p>
    <ul>
      <li data-i18n="privacy.s7.access" set:html={t('fr', 'privacy.s7.access')} />
      <li data-i18n="privacy.s7.rectification" set:html={t('fr', 'privacy.s7.rectification')} />
      <li data-i18n="privacy.s7.erasure" set:html={t('fr', 'privacy.s7.erasure')} />
      <li data-i18n="privacy.s7.portability" set:html={t('fr', 'privacy.s7.portability')} />
      <li data-i18n="privacy.s7.opposition" set:html={t('fr', 'privacy.s7.opposition')} />
    </ul>
    <p data-i18n="privacy.s7.contact" set:html={t('fr', 'privacy.s7.contact')} />
    <p data-i18n="privacy.s7.authority" set:html={t('fr', 'privacy.s7.authority')} />
  </div>

  <!-- Section 8 -->
  <div class="card">
    <h2 data-i18n="privacy.s8.title">{t('fr', 'privacy.s8.title')}</h2>
    <p data-i18n="privacy.s8.intro">{t('fr', 'privacy.s8.intro')}</p>
    <ul>
      <li data-i18n="privacy.s8.li1">{t('fr', 'privacy.s8.li1')}</li>
      <li data-i18n="privacy.s8.li2">{t('fr', 'privacy.s8.li2')}</li>
      <li data-i18n="privacy.s8.li3">{t('fr', 'privacy.s8.li3')}</li>
      <li data-i18n="privacy.s8.li4">{t('fr', 'privacy.s8.li4')}</li>
    </ul>
  </div>

  <!-- Section 9 -->
  <div class="card">
    <h2 data-i18n="privacy.s9.title">{t('fr', 'privacy.s9.title')}</h2>
    <p data-i18n="privacy.s9.intro">{t('fr', 'privacy.s9.intro')}</p>
    <p>
      <strong>Nicolas MA</strong><br/>
      <a href="mailto:contact@micitracker.com">contact@micitracker.com</a>
    </p>
  </div>
</Layout>
