---
import Layout from '../layouts/Layout.astro';
import { t } from '../i18n/index';
---

<Layout title="Accueil">
  <style>
    .hero {
      text-align: center;
      padding: 56px 0 48px;
    }
    .hero-icon {
      font-size: 56px;
      display: block;
      margin-bottom: 16px;
    }
    .hero h1 {
      font-size: 40px;
      font-weight: 800;
      color: #2D6A4F;
      margin-bottom: 14px;
    }
    .beta-badge {
      display: inline-block;
      background: #2D6A4F;
      color: #fff;
      font-size: 13px;
      font-weight: 700;
      padding: 5px 14px;
      border-radius: 20px;
      margin-bottom: 14px;
    }
    .hero-tagline {
      font-size: 19px;
      color: #6B7280;
      line-height: 1.7;
      max-width: 460px;
      margin: 0 auto;
    }

    /* Stores */
    .stores {
      margin: 40px 0;
      text-align: center;
    }
    .stores-title {
      font-size: 11px;
      font-weight: 700;
      color: #9CA3AF;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 20px;
    }
    .store-cards {
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .store-card {
      background: #fff;
      border: 1px solid #E5E7EB;
      border-radius: 16px;
      padding: 20px 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      min-width: 150px;
    }
    .store-qr {
      position: relative;
      width: 110px;
      height: 110px;
      border-radius: 10px;
      overflow: hidden;
      background: #F3F4F6;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .store-qr-placeholder {
      opacity: 0.15;
    }
    .store-qr-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255,255,255,0.6);
    }
    .store-soon {
      background: #2D6A4F;
      color: #fff;
      font-size: 10px;
      font-weight: 700;
      padding: 3px 10px;
      border-radius: 20px;
      white-space: nowrap;
    }
    .store-label {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 15px;
      font-weight: 600;
      color: #374151;
    }

    /* Features */
    .features {
      margin-top: 48px;
    }
    .features-title {
      font-size: 13px;
      font-weight: 700;
      color: #9CA3AF;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 16px;
      text-align: center;
    }
    .features-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    @media (max-width: 480px) {
      .features-grid { grid-template-columns: 1fr; }
    }
    .feature-card {
      background: #fff;
      border: 1px solid #E5E7EB;
      border-radius: 14px;
      padding: 24px;
    }
    .feature-icon {
      font-size: 28px;
      margin-bottom: 10px;
    }
    .feature-title {
      font-size: 17px;
      font-weight: 700;
      color: #1A1A2E;
      margin-bottom: 6px;
    }
    .feature-desc {
      font-size: 16px;
      color: #6B7280;
      line-height: 1.5;
    }

    /* Why section */
    .why {
      margin-top: 48px;
      text-align: center;
      background: #fff;
      border: 1px solid #E5E7EB;
      border-radius: 16px;
      padding: 32px 28px;
    }
    .why-title {
      font-size: 22px;
      font-weight: 800;
      color: #2D6A4F;
      margin-bottom: 12px;
    }
    .why-text {
      font-size: 16px;
      color: #6B7280;
      line-height: 1.7;
      max-width: 520px;
      margin: 0 auto;
    }

    /* CTA section */
    .cta {
      margin-top: 40px;
      text-align: center;
      padding-bottom: 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .cta-title {
      font-size: 18px;
      font-weight: 700;
      color: #1A1A2E;
      margin-bottom: 20px;
    }
    .cta-buttons {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .cta-btn {
      display: inline-block;
      padding: 14px 28px;
      border-radius: 10px;
      font-size: 16px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.15s;
    }
    .cta-btn-primary {
      background: #2D6A4F;
      color: #fff;
    }
    .cta-btn-primary:hover {
      background: #245a42;
    }
    .cta-btn-secondary {
      background: #fff;
      color: #2D6A4F;
      border: 1px solid #2D6A4F;
    }
    .cta-btn-secondary:hover {
      background: #F0FDF4;
    }
  </style>

  <!-- Hero -->
  <div class="hero">
    <span class="hero-icon">🌿</span>
    <h1>MICI Tracker</h1>
    <span class="beta-badge" data-i18n="home.beta">{t('fr', 'home.beta')}</span>
    <p class="hero-tagline" data-i18n="home.tagline">{t('fr', 'home.tagline')}</p>
  </div>

  <!-- Download -->
  <div class="stores">
    <div class="stores-title" data-i18n="home.stores.title">{t('fr', 'home.stores.title')}</div>
    <div class="store-cards">
      <!-- Android -->
      <div class="store-card">
        <div class="store-qr">
          <!-- QR code placeholder pattern -->
          <svg class="store-qr-placeholder" width="90" height="90" viewBox="0 0 9 9" fill="#1A1A2E" xmlns="http://www.w3.org/2000/svg">
            <rect x="0" y="0" width="3" height="3"/><rect x="4" y="0" width="1" height="1"/><rect x="6" y="0" width="3" height="3"/>
            <rect x="0" y="4" width="1" height="1"/><rect x="2" y="4" width="1" height="1"/><rect x="4" y="4" width="1" height="1"/><rect x="6" y="4" width="1" height="1"/><rect x="8" y="4" width="1" height="1"/>
            <rect x="0" y="6" width="3" height="3"/><rect x="4" y="6" width="1" height="1"/><rect x="6" y="7" width="1" height="1"/><rect x="8" y="6" width="1" height="1"/>
            <rect x="1" y="1" width="1" height="1" fill="#F3F4F6"/><rect x="7" y="1" width="1" height="1" fill="#F3F4F6"/><rect x="1" y="7" width="1" height="1" fill="#F3F4F6"/>
          </svg>
          <div class="store-qr-overlay">
            <span class="store-soon" data-i18n="home.stores.soon">{t('fr', 'home.stores.soon')}</span>
          </div>
        </div>
        <div class="store-label">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#374151"><path d="M3.18 23.76c.3.17.64.24.99.2l11.87-11.87L12.2 8.24 3.18 23.76zM20.47 10.3l-2.5-1.44-3.16 3.16 3.16 3.16 2.52-1.45c.72-.41.72-1.43-.02-2.43zM2.01 1.05C1.7 1.37 1.5 1.85 1.5 2.5v19c0 .65.2 1.13.52 1.45l.08.07 10.64-10.64v-.25L2.09.98l-.08.07zM15.04 7.85L4.27.58c-.3-.18-.58-.23-.83-.17l11.87 11.87-2.27-4.43z"/></svg>
          Android
        </div>
      </div>
      <!-- iOS -->
      <div class="store-card">
        <div class="store-qr">
          <svg class="store-qr-placeholder" width="90" height="90" viewBox="0 0 9 9" fill="#1A1A2E" xmlns="http://www.w3.org/2000/svg">
            <rect x="0" y="0" width="3" height="3"/><rect x="5" y="0" width="1" height="1"/><rect x="6" y="0" width="3" height="3"/>
            <rect x="1" y="4" width="1" height="1"/><rect x="3" y="4" width="2" height="1"/><rect x="6" y="4" width="2" height="1"/>
            <rect x="0" y="6" width="3" height="3"/><rect x="4" y="7" width="2" height="1"/><rect x="7" y="6" width="2" height="1"/>
            <rect x="1" y="1" width="1" height="1" fill="#F3F4F6"/><rect x="7" y="1" width="1" height="1" fill="#F3F4F6"/><rect x="1" y="7" width="1" height="1" fill="#F3F4F6"/>
          </svg>
          <div class="store-qr-overlay">
            <span class="store-soon" data-i18n="home.stores.soon">{t('fr', 'home.stores.soon')}</span>
          </div>
        </div>
        <div class="store-label">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#374151"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
          iOS
        </div>
      </div>
    </div>
  </div>

  <!-- Features -->
  <div class="features">
    <div class="features-title" data-i18n="home.features.title">{t('fr', 'home.features.title')}</div>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">📊</div>
        <div class="feature-title" data-i18n="home.feat1.title">{t('fr', 'home.feat1.title')}</div>
        <div class="feature-desc" data-i18n="home.feat1.desc">{t('fr', 'home.feat1.desc')}</div>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🥦</div>
        <div class="feature-title" data-i18n="home.feat2.title">{t('fr', 'home.feat2.title')}</div>
        <div class="feature-desc" data-i18n="home.feat2.desc">{t('fr', 'home.feat2.desc')}</div>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🩺</div>
        <div class="feature-title" data-i18n="home.feat3.title">{t('fr', 'home.feat3.title')}</div>
        <div class="feature-desc" data-i18n="home.feat3.desc">{t('fr', 'home.feat3.desc')}</div>
      </div>
      <div class="feature-card">
        <div class="feature-icon">📈</div>
        <div class="feature-title" data-i18n="home.feat4.title">{t('fr', 'home.feat4.title')}</div>
        <div class="feature-desc" data-i18n="home.feat4.desc">{t('fr', 'home.feat4.desc')}</div>
      </div>
    </div>
  </div>

  <!-- Why -->
  <div class="why">
    <div class="why-title" data-i18n="home.why.title">{t('fr', 'home.why.title')}</div>
    <p class="why-text" data-i18n="home.why.text">{t('fr', 'home.why.text')}</p>
  </div>

  <!-- CTA -->
  <div class="cta">
    <div class="cta-title" data-i18n="home.cta.title">{t('fr', 'home.cta.title')}</div>
    <div class="cta-buttons">
      <a href="/app" class="cta-btn cta-btn-primary" data-i18n="home.cta.btn1">{t('fr', 'home.cta.btn1')}</a>
      <a href="/about" class="cta-btn cta-btn-secondary" data-i18n="home.cta.btn2">{t('fr', 'home.cta.btn2')}</a>
    </div>
  </div>
</Layout>
